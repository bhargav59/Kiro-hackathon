# Environment variables for CloudEngineered Platform

# Database
DATABASE_URL=sqlite:///./cloudengineered.db

# JWT Secret
SECRET_KEY=your-secret-key-change-in-production

# Google Gemini API Key for AI comparisons
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyARoP8tzMYAE0VRel6iYYh0EMBBZEFy3V4

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Stripe Payment Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (Create these in Stripe Dashboard -> Products)
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id_here
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly_id_here

# Frontend URL for redirects
FRONTEND_URL=http://localhost:3000
